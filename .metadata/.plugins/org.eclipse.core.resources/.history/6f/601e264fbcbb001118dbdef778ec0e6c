

/* ---------------------------------------------------------------------------


 * fsm.s — machine à états du panneau de commande (CEG 3536, laboratoire 1)
 *
 * Routines exportées : fsm_init (fournie), fsm_step (À COMPLÉTER)
 * Variables (.bss)   : etat, touch_enabled, compteur_transitions,
 *                      clignote_compteur, clignote_phase, touch_signal_compteur
 *
 * États (section 3) : ETAT_ARRET (rouge fixe), ETAT_MARCHE_AVANT (verte),
 *                     ETAT_MARCHE_ARRIERE (bleue), ETAT_ARRET_URGENCE (rouge 2 Hz)
 * Un seul point de mise à jour des DEL : fsm_maj_del (critère B3).
 * ------------------------------------------------------------------------- */


#include "registres.inc"

    .syntax unified
    .cpu    cortex-m33
    .thumb

    .bss
    .align  2
    .global etat
etat:                   .space  4   /* état courant (ETAT_x)                     */
    .global touch_enabled
touch_enabled:          .space  4   /* autorisation TouchPad, 0/1 (E7)           */
    .global compteur_transitions
compteur_transitions:   .space  4   /* nombre de transitions validées (T3, watch) */
clignote_compteur:      .space  4   /* pas de scrutation écoulés dans la demi-période */
clignote_phase:         .space  4   /* 0 rouge éteinte, 1 rouge allumée (E5)     */
touch_signal_compteur:  .space  4   /* pas restants d'extinction brève (E7)      */




/* ========================================================================== */
/* ================= DEBUT AJOUT E2 — MEMOIRE DU PROCHAIN SENS ============== */
/* La section .bss est mise a zero par le code de demarrage fourni.           */
/* Le premier depart se fera donc en avant, sans modifier fsm_init.           */
/* ========================================================================== */

    .global prochain_sens              /* Rendre le symbole accessible hors de ce fichier. */
prochain_sens: .space 4                 /* Reserver un mot : 0 = prochain depart avant, 1 = arriere. */

/* ========================================================================== */
/* ================== FIN AJOUT E2 — MEMOIRE DU PROCHAIN SENS =============== */
/* ========================================================================== */






/* ---- Table état -> DEL (un octet par état) ------------------------------ */
    .section .rodata
etat_vers_del:
    .byte   LED_ROUGE       /* ETAT_ARRET          */
    .byte   LED_VERTE       /* ETAT_MARCHE_AVANT   */
    .byte   LED_BLEUE       /* ETAT_MARCHE_ARRIERE */
    .byte   LED_ROUGE       /* ETAT_ARRET_URGENCE (clignotante, voir fsm_maj_del) */

    .text
    .align  2

/* void fsm_init(void)
 * État initial ARRÊT, variables à zéro, DEL rouge seule (E1).
 * Appelle fsm_maj_del : LR sauvegardé ; push {r4, lr} garde l'alignement 8. */
    .global fsm_init
    .type   fsm_init, %function
fsm_init:
    push    {r4, lr}
    movs    r1, #0
    ldr     r0, =etat
    movs    r2, #ETAT_ARRET
    str     r2, [r0]
    ldr     r0, =touch_enabled
    str     r1, [r0]
    ldr     r0, =compteur_transitions
    str     r1, [r0]
    ldr     r0, =clignote_compteur
    str     r1, [r0]
    ldr     r0, =clignote_phase
    str     r1, [r0]
    ldr     r0, =touch_signal_compteur
    str     r1, [r0]
    bl      fsm_maj_del
    pop     {r4, pc}
    .size   fsm_init, .-fsm_init

/* void fsm_step(void)
 * Un pas de la machine à états, appelé toutes les PERIODE_SCRUTATION_MS.
 * Lit les événements validés (button_pressed) et le drapeau estop_flag,
 * applique les transitions E2 à E7, puis met à jour les DEL (fsm_maj_del).
 *
 * À COMPLÉTER — ordre recommandé :
 *   A. E4/E5 : si estop_flag == 1 : estop_flag = 0 ; etat = ETAT_ARRET_URGENCE ;
 *      clignote_compteur = 0 ; clignote_phase = 1.
 *   B. si etat == ETAT_ARRET_URGENCE :
 *        - E5 : les appuis sur User sont ignorés (appeler quand même
 *          button_pressed(BTN_USER) pour entretenir l'anti-rebond) ;
 *        - E6 : si button_pressed(BTN_TOUCH) == 1 ET button_raw(BTN_ESTOP) == 0
 *          (E-Stop relâché) : etat = ETAT_ARRET (acquittement). Sinon rester.
 *      sinon :
 *        - E2 : si button_pressed(BTN_USER) == 1 :
 *              ARRET -> MARCHE_AVANT, MARCHE_AVANT -> ARRET (puis ARRET -> MARCHE_ARRIERE
 *              au prochain appui, MARCHE_ARRIERE -> ARRET). Une variable "prochain sens"
 *              en .bss permet d'alterner avant/arrière à partir d'ARRÊT.
 *              compteur_transitions++ à chaque transition.
 *        - E7 : si button_pressed(BTN_TOUCH) == 1 : touch_enabled ^= 1 ;
 *              touch_signal_compteur = TOUCH_SIGNAL_MS / PERIODE_SCRUTATION_MS.
 *   C. bl fsm_maj_del.
 * Invariants (E9) : jamais deux DEL allumées (garanti par led_set) ; jamais de
 * sortie d'ARRÊT_URGENCE sans acquittement.
 * AAPCS : appelle d'autres routines -> push {r4, lr}.                         */
    .global fsm_step
    .type   fsm_step, %function
fsm_step:




    push    {r4, lr}    /* push {r4,r5, r6, lr}}*/

	ldr r6, [r6]
	cmp r0 #ETAT_ARRET

    /* ----- À COMPLÉTER : étapes A et B ----- */

    /* ----- À COMPLÉTER : étapes A et B ----- */



/* ========================================================================== */
/* ================= DEBUT AJOUT E4/E5/E9 — ENTREE EN URGENCE =============== */
/* L'ISR dans estop.s met les sorties en securite et pose estop_flag.          */
/* Ce bloc effectue ensuite le changement d'etat logiciel.                   */
/* Le niveau brut permet aussi de reconnaitre un E-Stop deja maintenu.        */
/* ========================================================================== */

    movs    r0, #BTN_ESTOP              /* Selectionner le bouton E-Stop. */
    bl      button_raw                 /* Lire son niveau normalise : 1 = appuye. */
    cmp     r0, #1                      /* Verifier si E-Stop est actuellement actif. */
    beq     fsm_entree_urgence          /* Rejoindre le traitement urgence si le bouton est maintenu. */

    ldr     r0, =estop_flag             /* Charger l'adresse du drapeau pose par l'ISR. */
    ldr     r1, [r0]                    /* Lire une eventuelle notification d'urgence. */
    cmp     r1, #0                      /* Verifier si une notification est presente. */
    beq     fsm_check_urgence           /* Sinon, examiner l'etat deja memorise. */

fsm_entree_urgence:                     /* Point commun aux detections par niveau et par drapeau. */
    ldr     r0, =estop_flag             /* Recharger l'adresse du drapeau apres les appels. */
    movs    r1, #0                      /* Preparer la consommation de la notification. */
    str     r1, [r0]                    /* Effacer la notification traitee. */

    ldr     r4, =etat                   /* Conserver l'adresse de l'etat dans r4. */
    ldr     r0, [r4]                    /* Lire l'etat courant. */
    cmp     r0, #ETAT_ARRET_URGENCE     /* Verifier si l'urgence est deja active. */
    beq     fsm_check_urgence           /* Conserver le clignotement si l'on est deja en urgence. */

    movs    r0, #ETAT_ARRET_URGENCE     /* Choisir l'etat d'arret d'urgence. */
    str     r0, [r4]                    /* Memoriser le nouvel etat. */

    ldr     r0, =clignote_compteur      /* Charger l'adresse du compteur de clignotement. */
    movs    r1, #0                      /* Preparer le debut d'une demi-periode. */
    str     r1, [r0]                    /* Initialiser le compteur a zero. */

    ldr     r0, =clignote_phase         /* Charger l'adresse de la phase de clignotement. */
    movs    r1, #1                      /* Choisir la premiere phase rouge allumee. */
    str     r1, [r0]                    /* Enregistrer la phase initiale. */

    ldr     r0, =touch_signal_compteur  /* Charger l'adresse de l'extinction Touch temporaire. */
    movs    r1, #0                      /* Preparer son annulation. */
    str     r1, [r0]                    /* Donner priorite a la signalisation d'urgence. */

/* ========================================================================== */
/* ================== FIN AJOUT E4/E5/E9 — ENTREE EN URGENCE ================ */
/* ========================================================================== */





/* ========================================================================== */
/* ================= DEBUT AJOUT E5/E6/E9 — TRAITEMENT EN URGENCE ============ */
/* User est scrute pour entretenir E3, mais son evenement est ignore.         */
/* Touch ne peut acquitter que si E-Stop est relache.                         */
/* ========================================================================== */

fsm_check_urgence:                     /* Choisir la branche urgence ou la branche normale. */
    ldr     r4, =etat                   /* Charger l'adresse de l'etat dans r4. */
    ldr     r0, [r4]                    /* Lire l'etat courant. */
    cmp     r0, #ETAT_ARRET_URGENCE     /* Verifier si le systeme est en urgence. */
    bne     fsm_normal_state            /* Sinon, traiter les commandes normales. */

    movs    r0, #BTN_USER               /* Selectionner User. */
    bl      button_pressed             /* Entretenir son anti-rebond sans utiliser l'evenement. */

    movs    r0, #BTN_TOUCH              /* Selectionner Touch. */
    bl      button_pressed             /* Chercher un nouvel appui Touch valide. */
    cmp     r0, #1                      /* Verifier si cet appui vient d'etre valide. */
    bne     fsm_step_fin                /* Sans nouvel appui, rester en urgence. */

    movs    r0, #BTN_ESTOP              /* Selectionner E-Stop. */
    bl      button_raw                 /* Lire son niveau actuel. */
    cmp     r0, #0                      /* Verifier que E-Stop est relache. */
    bne     fsm_step_fin                /* Refuser l'acquittement si E-Stop reste actif. */

    ldr     r0, =estop_flag             /* Charger l'adresse de la notification ISR. */
    ldr     r1, [r0]                    /* Lire une notification eventuellement survenue entre-temps. */
    cmp     r1, #0                      /* Verifier l'absence de nouvelle notification. */
    bne     fsm_step_fin                /* Sinon, refuser cet acquittement. */

    movs    r0, #ETAT_ARRET             /* Choisir ARRET, sans reprise automatique de marche. */
    str     r0, [r4]                    /* Enregistrer l'acquittement. */

    ldr     r0, =touch_signal_compteur  /* Charger l'adresse du compteur d'extinction Touch. */
    movs    r1, #0                      /* Preparer sa remise a zero. */
    str     r1, [r0]                    /* Permettre le retour au rouge fixe. */

    ldr     r0, =btn_valide             /* Acceder aux niveaux valides utilises par ton E3. */
    movs    r1, #1                      /* Considerer User comme un bouton deja appuye. */
    str     r1, [r0, #(BTN_USER * 4)]   /* Exiger un relachement valide avant un nouvel appui User. */

    ldr     r0, =btn_compteur           /* Acceder aux compteurs utilises par ton E3. */
    movs    r1, #0                      /* Recommencer le comptage du relachement de User. */
    str     r1, [r0, #(BTN_USER * 4)]   /* Reinitialiser seulement le compteur de User. */

    ldr     r0, =compteur_transitions   /* Charger l'adresse du compteur de transitions. */
    ldr     r1, [r0]                    /* Lire sa valeur actuelle. */
    adds    r1, r1, #1                  /* Compter l'acquittement vers ARRET. */
    str     r1, [r0]                    /* Enregistrer le nouveau compteur. */
    b       fsm_step_fin                /* Terminer sans traiter un depart dans ce meme pas. */

/* ========================================================================== */
/* ================== FIN AJOUT E5/E6/E9 — TRAITEMENT EN URGENCE ============= */
/* ========================================================================== */





/* ========================================================================== */
/* ================= DEBUT AJOUT E2 — TRANSITIONS NORMALES ================== */
/* Sequence : ARRET -> AVANT -> ARRET -> ARRIERE -> ARRET.                    */
/* prochain_sens change uniquement lors d'un depart depuis ARRET.            */
/* ========================================================================== */

fsm_normal_state:                      /* Point d'entree du traitement normal. */
    movs    r0, #BTN_USER               /* Selectionner le bouton User. */
    bl      button_pressed             /* Lire un nouvel appui valide avec ton E3. */
    cmp     r0, #1                      /* Verifier si un evenement d'appui est present. */
    bne     fsm_check_touch             /* Sans appui User, traiter quand meme Touch. */

    ldr     r4, =etat                   /* Charger l'adresse de l'etat courant. */
    ldr     r0, [r4]                    /* Lire cet etat. */
    cmp     r0, #ETAT_ARRET             /* Verifier si le systeme est a l'arret. */
    beq     fsm_choisir_depart          /* Depuis ARRET, choisir le sens du prochain depart. */

    cmp     r0, #ETAT_MARCHE_AVANT     /* Verifier si le systeme est en marche avant. */
    beq     fsm_vers_arret              /* Un appui pendant AVANT provoque un arret. */

    cmp     r0, #ETAT_MARCHE_ARRIERE    /* Verifier si le systeme est en marche arriere. */
    beq     fsm_vers_arret              /* Un appui pendant ARRIERE provoque un arret. */

    b       fsm_step_fin                /* Ne pas modifier un autre etat avec User. */

fsm_choisir_depart:                     /* Choisir un depart depuis ARRET. */
    ldr     r2, =prochain_sens          /* Charger l'adresse du prochain sens dans r2. */
    ldr     r1, [r2]                    /* Lire le sens memorise. */
    cmp     r1, #0                      /* Le prochain depart est-il en avant ? */
    bne     fsm_marche_arriere          /* Sinon, choisir l'arriere. */

fsm_marche_avant:                       /* Preparer un depart en avant. */
    movs    r0, #ETAT_MARCHE_AVANT     /* Placer le nouvel etat dans r0. */
    movs    r1, #1                      /* Preparer l'arriere pour le depart suivant. */
    b       fsm_depart                  /* Rejoindre l'enregistrement commun du depart. */

fsm_marche_arriere:                     /* Preparer un depart en arriere. */
    movs    r0, #ETAT_MARCHE_ARRIERE    /* Placer le nouvel etat dans r0. */
    movs    r1, #0                      /* Preparer l'avant pour le depart suivant. */
    b       fsm_depart                  /* Rejoindre l'enregistrement commun du depart. */

fsm_depart:                            /* Enregistrer le depart prepare. */
    str     r0, [r4]                    /* Memoriser le nouvel etat. */
    str     r1, [r2]                    /* Memoriser le sens du prochain depart. */
    b       fsm_compte_user             /* Compter la transition effectuee. */

fsm_vers_arret:                         /* Traiter un appui User pendant une marche. */
    movs    r0, #ETAT_ARRET             /* Choisir l'etat ARRET. */
    str     r0, [r4]                    /* Memoriser l'arret sans changer prochain_sens. */

fsm_compte_user:                        /* Compter une transition provoquee par User. */
    ldr     r0, =compteur_transitions   /* Charger l'adresse du compteur de transitions. */
    ldr     r1, [r0]                    /* Lire sa valeur actuelle. */
    adds    r1, r1, #1                  /* Ajouter exactement une transition. */
    str     r1, [r0]                    /* Enregistrer le nouveau compteur. */

/* ========================================================================== */
/* ================== FIN AJOUT E2 — TRANSITIONS NORMALES =================== */
/* ========================================================================== */



/* ========================================================================== */
/* ================= DEBUT AJOUT E7 — TOUCH HORS URGENCE ==================== */
/* Touch inverse touch_enabled et demarre une extinction temporaire.         */
/* Aucun changement de l'etat de marche n'est effectue ici.                  */
/* ========================================================================== */

fsm_check_touch:                        /* Traiter Touch independamment de User. */
    movs    r0, #BTN_TOUCH              /* Selectionner le bouton Touch. */
    bl      button_pressed             /* Chercher un nouvel appui valide. */
    cmp     r0, #1                      /* Verifier si un evenement est present. */
    bne     fsm_step_fin                /* Sinon, terminer ce pas. */

    ldr     r0, =touch_enabled          /* Charger l'adresse de l'autorisation Touch. */
    ldr     r1, [r0]                    /* Lire sa valeur actuelle. */
    eors    r1, r1, #1                  /* Inverser zero et un. */
    str     r1, [r0]                    /* Memoriser la nouvelle autorisation. */

    ldr     r0, =touch_signal_compteur  /* Charger l'adresse du compteur d'extinction. */
    ldr     r1, =(TOUCH_SIGNAL_MS / PERIODE_SCRUTATION_MS) /* Calculer la duree en pas. */
    str     r1, [r0]                    /* Demarrer la signalisation temporaire de Touch. */

/* ========================================================================== */
/* ================== FIN AJOUT E7 — TOUCH HORS URGENCE ===================== */
/* ========================================================================== */



/* AJOUT : etiquette commune devant les instructions de fin fournies. */
fsm_step_fin:
    bl      fsm_maj_del
    pop     {r4, pc}
    .size   fsm_step, .-fsm_step

/* static void fsm_maj_del(void)  — routine locale, seul point d'appel de led_set
 * ARRÊT, MARCHE_AVANT, MARCHE_ARRIÈRE : DEL fixe d'après etat_vers_del.
 * ARRÊT_URGENCE : À COMPLÉTER (E5) — alterner rouge / aucune toutes les
 *   CLIGNOTEMENT_DEMI_MS / PERIODE_SCRUTATION_MS appels (clignote_compteur,
 *   clignote_phase).
 * Hors urgence : À COMPLÉTER (E7) — tant que touch_signal_compteur > 0,
 *   décrémenter et afficher LED_AUCUNE au lieu de la DEL de l'état.          */
    .type   fsm_maj_del, %function
fsm_maj_del:
    push    {r4, lr}
    ldr     r0, =etat
    ldr     r4, [r0]
    cmp     r4, #ETAT_ARRET_URGENCE
    bhi     fsm_maj_del_fin             /* état invalide : ne rien changer */

    /* ----- À COMPLÉTER : clignotement (E5) et extinction brève (E7) ----- */



/* ========================================================================== */
/* ================= DEBUT AJOUT E5 — CLIGNOTEMENT NON BLOQUANT ============= */
/* Un appel ajoute un pas au compteur ; aucun delay_ms n'est utilise ici.     */
/* Avec un pas reel de 1 ms : 250 pas allumes + 250 pas eteints = 2 Hz.         */
/* ========================================================================== */

    cmp     r4, #ETAT_ARRET_URGENCE     /* Verifier si l'etat courant est l'urgence. */
    bne     fsm_maj_del_touch_check     /* Sinon, traiter l'affichage hors urgence. */

    ldr     r0, =clignote_compteur      /* Charger l'adresse du compteur de demi-periode. */
    ldr     r1, [r0]                    /* Lire les pas deja ecoules. */
    adds    r1, r1, #1                  /* Compter ce nouvel appel. */

    ldr     r2, =(CLIGNOTEMENT_DEMI_MS / PERIODE_SCRUTATION_MS) /* Seuil d'une demi-periode. */
    cmp     r1, r2                      /* Verifier si le seuil est atteint. */
    blo     fsm_maj_del_phase_set       /* Sinon, enregistrer sans changer la phase. */

    movs    r1, #0                      /* Preparer une nouvelle demi-periode. */
    str     r1, [r0]                    /* Remettre le compteur a zero. */

    ldr     r0, =clignote_phase         /* Charger l'adresse de la phase. */
    ldr     r1, [r0]                    /* Lire la phase actuelle. */
    eors    r1, r1, #1                  /* Alterner entre rouge allumee et eteinte. */
    str     r1, [r0]                    /* Memoriser la nouvelle phase. */
    b       fsm_maj_del_phase_apply     /* Choisir la commande de DEL correspondante. */

fsm_maj_del_phase_set:                  /* La demi-periode n'est pas encore terminee. */
    str     r1, [r0]                    /* Memoriser le compteur incremente. */

fsm_maj_del_phase_apply:                /* Traduire la phase en commande de DEL. */
    ldr     r0, =clignote_phase         /* Charger l'adresse de la phase. */
    ldr     r1, [r0]                    /* Lire zero ou un. */
    cmp     r1, #1                      /* Verifier si le rouge doit etre allume. */
    beq     fsm_maj_del_rouge           /* Si oui, selectionner rouge. */
    movs    r0, #LED_AUCUNE             /* Sinon, selectionner l'extinction de toutes les DEL. */
    b       fsm_maj_del_apply           /* Rejoindre l'unique appel au pilote. */

fsm_maj_del_rouge:                      /* Phase allumee de l'urgence. */
    movs    r0, #LED_ROUGE              /* Selectionner la DEL rouge. */
    b       fsm_maj_del_apply           /* Rejoindre l'unique appel au pilote. */

/* ========================================================================== */
/* ================== FIN AJOUT E5 — CLIGNOTEMENT NON BLOQUANT ============== */
/* ========================================================================== */





/* ========================================================================== */
/* ================= DEBUT AJOUT E7 — EXTINCTION TEMPORAIRE ================= */
/* Hors urgence, un compteur positif impose LED_AUCUNE pendant ce pas.        */
/* Quand le compteur est nul, la table fournie choisit la DEL normale.        */
/* ========================================================================== */

fsm_maj_del_touch_check:                /* Examiner l'extinction Touch hors urgence. */
    ldr     r0, =touch_signal_compteur  /* Charger l'adresse du nombre de pas restants. */
    ldr     r1, [r0]                    /* Lire ce nombre. */
    cmp     r1, #0                      /* Verifier si une extinction est en cours. */
    ble     fsm_maj_del_normal_led      /* Sinon, rejoindre la lecture de table fournie. */

    subs    r1, r1, #1                  /* Consommer un pas d'extinction. */
    str     r1, [r0]                    /* Memoriser le nombre de pas restants. */
    movs    r0, #LED_AUCUNE             /* Eteindre toutes les DEL pendant ce pas. */
    b       fsm_maj_del_apply           /* Rejoindre l'unique appel au pilote. */

/* ========================================================================== */
/* ================== FIN AJOUT E7 — EXTINCTION TEMPORAIRE ================== */
/* ========================================================================== */



/* AJOUT : etiquette devant les deux instructions de lecture fournies. */
fsm_maj_del_normal_led:
    ldr     r1, =etat_vers_del
    ldrb    r0, [r1, r4]                /* r0 = DEL associée à l'état */



/* ========================================================================== */
/* ================= DEBUT AJOUT E9 — PROTECTION DES ECRITURES ============== */
/* led_set effectue plusieurs ecritures sur plusieurs ports GPIO.            */
/* Proteger cette sequence contre une interruption E-Stop au milieu.         */
/* r4 peut contenir PRIMASK ici : l'etat n'est plus necessaire pour ce pas.    */
/* Le prologue fourni a deja sauvegarde la valeur initiale de r4.             */
/* ========================================================================== */

fsm_maj_del_apply:                      /* Point commun de toutes les commandes de DEL. */
    mrs     r4, PRIMASK                 /* Sauver le masque d'interruptions precedent. */
    cpsid   i                          /* Masquer temporairement les interruptions configurables. */

    ldr     r1, =estop_flag             /* Charger l'adresse de la notification d'urgence. */
    ldr     r1, [r1]                    /* Lire une notification survenue depuis le choix de DEL. */
    cmp     r1, #0                      /* Verifier si une urgence a ete signalee. */
    bne     fsm_sortie_rouge            /* Si oui, remplacer la commande par rouge. */
    b       fsm_sortie_ecrire           /* Sinon, conserver la commande actuelle dans r0. */

fsm_sortie_rouge:                       /* Donner priorite a l'urgence deja signalee. */
    movs    r0, #LED_ROUGE              /* Imposer rouge au lieu de l'ancienne commande. */

fsm_sortie_ecrire:                      /* Rejoindre l'appel au pilote fourni. */

/* ========================================================================== */
/* ================== FIN AJOUT E9 — AVANT L'APPEL FOURNI =================== */
/* ========================================================================== */



    bl      led_set



/* ========================================================================== */
/* ================= DEBUT AJOUT E9 — RESTAURATION ========================== */
/* Une interruption recue pendant la section pourra etre traitee ensuite,    */
/* si elle n'etait pas deja masquee avant l'entree dans cette section.        */
/* ========================================================================== */

    dsb                                /* Attendre l'achevement des acces memoire precedents. */
    msr     PRIMASK, r4                 /* Restaurer exactement le masque sauvegarde. */

/* ========================================================================== */
/* ================== FIN AJOUT E9 — RESTAURATION =========================== */
/* ========================================================================== */



fsm_maj_del_fin:
    pop     {r4, pc}
    .size   fsm_maj_del, .-fsm_maj_del

