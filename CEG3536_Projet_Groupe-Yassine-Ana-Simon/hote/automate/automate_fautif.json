  "invariants": [
    {
      "nom": "I1 (impose) moteur non autorise dans INIT, PRET, ARRET_EVENEMENT, ARRET_URGENCE et DEFAUT",
      "type": "sortie",
      "etats": [
        "INIT",
        "PRET",
        "ARRET_EVENEMENT",
        "ARRET_URGENCE",
        "DEFAUT"
      ],
      "sortie": "moteur",
      "valeur": 0
    },
    {
      "nom": "I2 (impose) aucune transition d'un etat d'arret ou de defaut vers MANUEL ou AUTONOME",
      "type": "interdit",
      "de": [
        "INIT",
        "ARRET_EVENEMENT",
        "ARRET_URGENCE",
        "DEFAUT"
      ],
      "vers": [
        "MANUEL",
        "AUTONOME"
      ]
    },
    {
      "nom": "I3 (impose) on ne quitte un arret pour PRET que par un acquittement explicite",
      "type": "interdit",
      "de": [
        "ARRET_EVENEMENT",
        "ARRET_URGENCE",
        "DEFAUT"
      ],
      "vers": [
        "PRET"
      ],
      "sur": [
        "ESTOP",
        "DEFAUT",
        "THERMIQUE",
        "OBSTACLE",
        "FEU",
        "FIN",
        "USER_MAN",
        "USER_AUT",
        "INIT_OK"
      ]
    },
    {
      "nom": "I4 (impose) E-Stop mene a ARRET_URGENCE depuis tous les etats",
      "type": "toujours",
      "sur": "ESTOP",
      "vers": "ARRET_URGENCE"
    },
    {
      "nom": "I5 (impose) changement de sens seulement en passant par PRET : aucune transition directe entre MANUEL et AUTONOME",
      "type": "interdit",
      "de": [
        "MANUEL",
        "AUTONOME"
      ],
      "vers": [
        "MANUEL",
        "AUTONOME"
      ]
    },
    {
      "nom": "I6 (impose, priorites) un defaut l'emporte sur tout sauf E-Stop",
      "type": "toujours",
      "sur": "DEFAUT",
      "vers": "DEFAUT",
      "sauf": [
        "ARRET_URGENCE"
      ]
    },
    {
      "nom": "I7 (impose, priorites) ARRET_URGENCE n'est jamais remplace par un etat de moindre priorite",
      "type": "interdit",
      "de": [
        "ARRET_URGENCE"
      ],
      "vers": [
        "INIT",
        "MANUEL",
        "AUTONOME",
        "ARRET_EVENEMENT",
        "DEFAUT"
      ]
    },
    {
      "nom": "I8 (impose, priorites) un defaut n'est jamais masque par un arret sur evenement",
      "type": "interdit",
      "de": [
        "DEFAUT"
      ],
      "vers": [
        "ARRET_EVENEMENT",
        "MANUEL",
        "AUTONOME"
      ]
    },
    {
      "nom": "I9 (equipe) alarme d'urgence implique moteur coupe",
      "type": "sortie",
      "si": {
        "alarme": 2
      },
      "alors": {
        "moteur": 0
      }
    },
    {
      "nom": "I10 (equipe) la regulation n'est active que moteur autorise",
      "type": "sortie",
      "si": {
        "regulation": 1
      },
      "alors": {
        "moteur": 1
      }
    },
    {
      "nom": "I11 (equipe) aucun etat piege : PRET reste toujours atteignable",
      "type": "retour",
      "vers": "PRET"
    },
    {
      "nom": "I12 (equipe) les sept etats sont accessibles depuis INIT",
      "type": "accessible"
    }
